<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRMSuite" parallel="tests" thread-count="8">
	<listeners>
		<listener class-name="com.listeners.TestListener"></listener>
	</listeners>
	<test name="OrangeHRMTest_chrome">
		<parameter name="browser" value="chrome" />
		<classes>
            <class name="com.sampleTest.ApiTest"/>
            <class name="com.sampleTest.DBVerificationTest" />
			<class name="com.sampleTest.HomePageTest" />
		</classes>
	</test>
    <test name="OrangeHRMTest_fireFox">
        <parameter name="browser" value="fireFox" />
        <classes>
            <class name="com.sampleTest.HomePageTest" />
        </classes>
    </test>
</suite>



